NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

SESSION_SECRET=your_session_secret_here_min_32_chars
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Optional
DATABASE_URL_OVERRIDE=
LOG_LEVEL=info
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here
OSRM_FOOT_URL=
# Server-only Google Directions key used by the licensed one-time bulk
# regenerator. Restrict this key to the Directions API and never put it in VITE_*.
GOOGLE_DIRECTIONS_API_KEY=

# Android Maps SDK key. Restrict it by Android package com.sikkago.app and the
# release signing SHA-1. The VITE value is passed to Capacitor's native plugin.
GOOGLE_MAPS_ANDROID_API_KEY=
VITE_GOOGLE_MAPS_ANDROID_API_KEY=
