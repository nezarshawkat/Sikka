<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:minHeight="64dp"
    android:layoutDirection="ltr"
    android:background="#258DFF"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/trip_badge_circle_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        android:src="@drawable/bg_circle_white" />

    <TextView
        android:id="@+id/trip_badge_text"
        android:layout_width="38dp"
        android:layout_height="40dp"
        android:layout_alignTop="@id/trip_badge_circle_bg"
        android:layout_alignBottom="@id/trip_badge_circle_bg"
        android:layout_alignStart="@id/trip_badge_circle_bg"
        android:layout_alignEnd="@id/trip_badge_circle_bg"
        android:gravity="center"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeMaxTextSize="10sp"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:fontFamily="@font/cairo_ar_bold"
        android:text="Bus" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/trip_badge_circle_bg"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/trip_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:gravity="end"
            android:textDirection="rtl"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/cairo_ar_bold"
            android:text="Sikka" />

        <TextView
            android:id="@+id/trip_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:gravity="end"
            android:textDirection="rtl"
            android:textColor="#E7F1FF"
            android:textSize="13sp"
            android:fontFamily="@font/cairo_ar_regular"
            android:text="toward destination" />
    </LinearLayout>
</RelativeLayout>
